# PostgreSQL (Neon / Render)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# LLM & Embedding Providers
GROQ_API_KEY=your_groq_api_key
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key
PINECONE_API_KEY=your_pinecone_api_key

# Vector Index & App Config
PINECONE_INDEX_NAME=nova-spa-faqs
SPA_TIMEZONE=Asia/Karachi

# Admin Auth (required to enable POST /upload-faqs; disabled with 503 if unset)
ADMIN_API_KEY=change_me_to_a_strong_secret

# Optional Zero-Cost Tier-3 Fallback Provider
OPENROUTER_API_KEY=
